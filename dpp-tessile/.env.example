# Public base URL used for GS1 Digital Link / QR targets (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://dpp.example.com

# Supabase project (Settings > API). Only the public anon key goes here.
# Never put the service_role key in a NEXT_PUBLIC_ variable or in client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mail (SMTP). Used for notifications about new organizations. Credentials only here and in Vercel, never in code.
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587, SMTP_USER=<your Brevo login>, SMTP_PASS=<SMTP key, not the account password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DPP Tessile <no-reply@mail.example.com>"
# Where notifications about new organizations go (you)
OPERATOR_EMAIL=
